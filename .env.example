# Telegram Bot Configuration
# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Webhook Configuration
# URL, на который Telegram будет отправлять updates
WEBHOOK_URL=https://datspike.xyz/swim-bot/webhook
# Секрет для проверки webhook запросов (X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=your-random-secret-string

# Server Configuration
# Порт для HTTP сервера (webhook listener)
PORT=8080

# Logging Configuration
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

# Database Configuration
# Путь к SQLite базе данных
DB_PATH=./swim-bot.db
